.npm
yarn.lock
pnpm-lock.yaml

# ===========================================
# KEEP IMPORTANT PROJECT FILES
# ===========================================
!LICENSE
!README.md
!.gitignore

!Jio-Chatbot/package.json
!Jio-Chatbot/package-lock.json
!Jio-Chatbot/requirements.txt

!Jio-Chatbot/next.config.js
!Jio-Chatbot/tailwind.config.js
!Jio-Chatbot/postcss.config.js
!Jio-Chatbot/eslint.config.js
!Jio-Chatbot/tsconfig.json
!Jio-Chatbot/next-env.d.ts

# ===========================================
# KEEP SOURCE CODE
# ===========================================
!Jio-Chatbot/app/**/*.ts
!Jio-Chatbot/app/**/*.tsx
!Jio-Chatbot/app/**/*.js
!Jio-Chatbot/app/**/*.jsx

!Jio-Chatbot/components/**/*.ts
!Jio-Chatbot/components/**/*.tsx
!Jio-Chatbot/components/**/*.js
!Jio-Chatbot/components/**/*.jsx

!Jio-Chatbot/lib/**/*.ts
!Jio-Chatbot/lib/**/*.js

!Jio-Chatbot/backend/app/**/*.py
!Jio-Chatbot/backend/app/routers/**/*.py
!Jio-Chatbot/backend/app/services/**/*.py

# ===========================================
# KEEP IMPORTANT DATA FILES
# ===========================================
!Jio-Chatbot/backend/app/data/qa_dataset.json
!Jio-Chatbot/backend/app/data/bad_words.json
!Jio-Chatbot/backend/app/data/document_requests.json
!Jio-Chatbot/backend/app/data/employees.json
!Jio-Chatbot/backend/app/data/hr_notifications.log

# ===========================================
# KEEP SCRIPTS & DOCS
# ===========================================
!Jio-Chatbot/scripts/**/*.py
!Jio-Chatbot/scripts/**/*.js
!Jio-Chatbot/**/*.md
!Jio-Chatbot/.env.example
!docker-compose*.yml
!Dockerfile*
!Procfile
